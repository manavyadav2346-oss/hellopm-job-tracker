# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Note: NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported as a fallback:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Note: The app includes a fully isolated "Sample Preview" mode with fictional data
# which works out-of-the-box before connecting Supabase credentials.
# To connect real accounts and persistent cloud data, provide the above credentials.
